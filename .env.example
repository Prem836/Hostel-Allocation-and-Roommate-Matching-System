# Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/hostel_allocation?replicaSet=rs0
MONGODB_TEST_URI=mongodb://localhost:27017/hostel_allocation_test?replicaSet=rs0

# Cache & Message Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex

# Institution Settings
INSTITUTION_ID=inst_default_01
DEFAULT_ALLOCATION_SEED=42

